# Copy to .env and replace every placeholder. Never commit real secrets.

FLASK_APP=wsgi.py
FLASK_CONFIG=development

# Required in production. Use a long random value.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# SQLAlchemy URL. Local Docker example:
# DATABASE_URL=postgresql+psycopg://itsm:itsm@localhost:5432/itsm
DATABASE_URL=sqlite:///itsm_dev.db

# true on a single web replica only (SLA scheduler, later phases)
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60

MAIL_ENABLED=false
