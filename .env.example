# Environment Configuration Template
# Copy to .env and replace with your secrets. Never commit actual secrets to version control.

FLASK_APP=wsgi.py
FLASK_CONFIG=development

# Security keys (Must be strong 32+ character random strings in production)
SECRET_KEY=dev-only-secret-key-change-in-production-12345
JWT_SECRET_KEY=dev-only-jwt-secret-key-change-in-production-12345

# Database Connection URL:
# 1) Local Development (SQLite):
DATABASE_URL=sqlite:///itsm_dev.db

# 2) Docker Compose / Cloud PostgreSQL (AWS RDS / IBM Cloud Databases for PostgreSQL):
# DATABASE_URL=postgresql+psycopg://itsm_user:itsm_secure_password@localhost:5432/itsm_db

# Scheduler & Background Workers (Enabled only on single web replica):
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60

# Outgoing Mail (Optional):
MAIL_ENABLED=false
